# ==========================================
# CẤU HÌNH HỆ THỐNG LEGAL RAG CHATBOT
# ==========================================

# --- Database (Cloud SQL / PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_rag_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=legal_rag_db

# --- Vector Database (Qdrant / Lance) ---
QDRANT_URL=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
COLLECTION_NAME=legal_documents

# --- Google Cloud & Vertex AI ---
PROJECT_ID=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
GCP_CREDENTIALS_DIR=./.secrets/gcp
GOOGLE_APPLICATION_CREDENTIALS=/var/run/gcp/application_default_credentials.json

# --- AI Models ---
EMBEDDING_MODEL_NAME=text-embedding-005
LLM_MODEL_NAME=gemini-2.5-flash

# --- Microservices Ports (Internal / Local mapping) ---
API_ROUTER_PORT=8080
AUTH_SERVICE_PORT=8081
UPLOAD_SERVICE_PORT=8082
RAG_SERVICE_PORT=8000
INGESTION_SERVICE_PORT=8001

# --- Security & JWT ---
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
JWT_EXPIRATION_TIME=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Observability / Logs ---
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
